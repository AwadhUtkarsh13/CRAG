# Copy to .env and fill in. Only OPENAI_API_KEY is required.

# --- LLM (required) ---------------------------------------------------------
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# GRADER_MODEL=gpt-4o-mini

# --- Web fallback (optional; corrective path is skipped without it) ----------
TAVILY_API_KEY=

# --- Email: verification codes and password resets (Gmail) -------------------
# Without these, codes are printed in the server window instead of emailed.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Example: SMTP_USERNAME=you@gmail.com  SMTP_FROM=CRAG <you@gmail.com>
# EMAIL_CODE_MINUTES=10
# EMAIL_CODE_ATTEMPTS=5
# EMAIL_RESEND_SECONDS=60

# --- Tracing (optional) -------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Retrieval tuning (defaults shown) ---------------------------------------
# EMBEDDING_PROVIDER=fastembed        # or "openai" (text-embedding-3-small)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# RERANK_TOP_N=3
# RERANK_WEIGHT=0.7
# MIN_RELEVANT_CHUNKS=1
# MAX_RETRIES=2                 # after an ungrounded answer
# MAX_UNHELPFUL_RETRIES=1       # after a grounded "not specified" answer
# WEB_SEARCH_DEPTH=advanced     # or "basic" (about half the Tavily credits)

# --- Cost control (defaults shown) ------------------------------------------
# CACHE_ENABLED=true
# WEB_CACHE_TTL_HOURS=24

# --- Web app (defaults shown) -------------------------------------------------
# PORT=8000
# SESSION_DAYS=14
# COOKIE_SECURE=false            # set true when served over HTTPS
# MAX_UPLOAD_MB=20
